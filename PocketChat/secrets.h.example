// Copy this file to "secrets.h" (same folder) and fill in your own values.
// secrets.h is listed in .gitignore, so it never gets committed.

// Home WiFi the board joins as a client (optional). Leave SSID empty to disable.
#define SECRET_STA_SSID ""
#define SECRET_STA_PASS ""

// The WiFi network the board creates itself.
// Password must be at least 8 characters; leave it empty for an open network.
#define SECRET_AP_SSID  "PocketChat"
#define SECRET_AP_PASS  "change-me-please"
